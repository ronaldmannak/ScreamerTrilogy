From d12e88ced5ae5b94c48bde4c2809b53da6f6ecae Mon Sep 17 00:00:00 2001
From: John Novak <john@johnnovak.net>
Date: Fri, 8 May 2026 19:20:00 +1000
Subject: [PATCH] build: Move PkgConfig find before configure_file

PkgConfig is needed by speexdsp (vcpkg has no cmake config for it)
and will be needed for zlib-ng detection on system-libs builds in a
subsequent commit. Move it before configure_file so it's available
for both use cases.
---
 CMakeLists.txt | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 23c9b1508acd0696e018b1cf382de2661d310c7b..1e9be5eacc075835087db4cff5f3171ac22a2d5d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -441,6 +441,10 @@ set(CUSTOM_DATADIR "${CMAKE_INSTALL_FULL_DATADIR}")
 set(project_name "${PROJECT_NAME}")
 set(version      "${PROJECT_VERSION}")
 
+# PkgConfig is needed for speexdsp (no cmake config in vcpkg) and
+# for zlib-ng detection on system-libs builds.
+find_package(PkgConfig REQUIRED)
+
 configure_file(
   src/dosbox_config.h.in.cmake
   ${CMAKE_CURRENT_BINARY_DIR}/include/dosbox_config.h
@@ -456,7 +460,6 @@ endif()
 set(CMAKE_BUILD_WITH_INSTALL_RPATH ON)
 
 # Find common external dependencies
-find_package(PkgConfig REQUIRED)
 find_package(SDL2 CONFIG REQUIRED)
 find_package(SDL2_image CONFIG REQUIRED)
 find_package(iir REQUIRED)
@@ -467,6 +470,8 @@ find_package(FluidSynth REQUIRED CONFIG)
 if (C_ALSA)
   find_package(ALSA REQUIRED)
 endif()
+
+# SpeexDSP: vcpkg has no cmake config, only a .pc file
 pkg_check_modules(SPEEXDSP REQUIRED IMPORTED_TARGET speexdsp)
 
 add_executable(dosbox src/main.cpp src/dosbox.cpp)
