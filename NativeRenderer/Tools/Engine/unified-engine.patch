+constexpr uint32_t BackendCall = 0x81b6b, BackendTarget = 0x843a8;
+constexpr uint32_t MainRaceReturn = 0x1fffc;
+constexpr uint32_t HudCall = 0x2001a, HudTarget = 0x23420;
+constexpr uint32_t FrameCall = 0x1ff54, FrameTarget = 0x1ff70;
+constexpr size_t HudPixels = 640*400;
