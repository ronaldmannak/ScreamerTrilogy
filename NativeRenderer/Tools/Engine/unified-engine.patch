+constexpr std::array<uint8_t, 5> OriginalCall = {0xe8,0x38,0x28,0x00,0x00};
+constexpr std::array<uint8_t, 5> MainRaceCall = {0xe8,0xb4,0x1a,0x06,0x00};
+constexpr std::array<uint8_t, 5> OriginalFrameCall = {0xe8,0x17,0x00,0x00,0x00};
+constexpr std::array<uint8_t, 5> MainHudCall = {0xe8,0x01,0x34,0x00,0x00};
+constexpr std::array<uint8_t, 7> WorldSave = {0x60,0x1e,0x06,0x0f,0xa0,0x0f,0xa8};
+struct State {
+    bool installed=false, ready=false;
+    uint32_t code_base=0, data_base=0;
+    callback_number_t callback=0, hud_begin=0, hud_end=0, frame_begin=0;
+    uint32_t last_outer_return=0, last_hud_mode=0;
+    uint64_t main_race_calls=0, hud_calls=0, hud_captures=0, hud_rejected=0;
+    uint64_t lease=0, callbacks=0, skipped=0, fallback=0, expired=0, stack_rejected=0;
+    std::string error;
+} state;
+uint64_t now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+uint32_t code(uint32_t link) { return state.code_base + link-CodeLink; }
+uint32_t data(uint32_t link) { return state.data_base + link-DataLink; }
+bool in_ram(uint64_t address, uint64_t size) {
+    return address+size <= static_cast<uint64_t>(MEM_TotalPages())*MemPageSize;
+}
+template<size_t N> bool matches(uint32_t address, const std::array<uint8_t,N>& expected) {
+    if(!in_ram(address,N))return false;
+    std::array<uint8_t,N> actual{};MEM_BlockRead(address,actual.data(),N);
+    return actual==expected;
+}
+std::array<uint8_t,5> hook_bytes() {
+    return {0xfe,0x38,state.callback,0x00,0x90};
+}
+bool live_ready() {
+    if(state.ready && now_ns()>state.lease) {
+        state.ready=false;state.expired++;
+    }
+    return state.ready;
