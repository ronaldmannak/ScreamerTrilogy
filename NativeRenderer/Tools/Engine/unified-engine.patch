+    const uint32_t sp=SegPhys(SegNames::ss)+reg_esp,bias=rally_helper-0x504dc;
+    const uint64_t limit=static_cast<uint64_t>(MEM_TotalPages())*MemPageSize;
+    if(static_cast<uint64_t>(sp)+1024>limit)return false;
+    std::array<uint32_t,256> stack;MEM_BlockRead(sp,stack.data(),sizeof(stack));
+    // Locate the closest validated application CALL return, not arbitrary
+    // stale values elsewhere in the stack. Original imports tail-jump into
+    // GLIDE2X; the active grDrawLine application return is C0EA0. Its caller
+    // is exactly 28 bytes later (two pointer args + four saved registers).
+    for(size_t i=0;i+7<stack.size();++i){
+        const uint32_t value=stack[i];
+        if(value<bias+0x20005||value>=bias+0xeedc0)continue;
