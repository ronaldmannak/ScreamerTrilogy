+// its return. It intercepts every byte store, including same-value stores.
+// Ordinary RAM reads and writes retain the original host backing addresses.
+struct HudPage { uint32_t page;PageHandler* original;HostPt host; };
+struct HudCoverage {
+    bool active=false, pending=false;
+    uint32_t framebuffer=0, mode=0;
+    uint64_t captured=0, sequence=0;
+    std::vector<HudPage> pages;
+    std::array<uint8_t,HudPixels> alpha{}, indices{};
+} hud;
+struct HudImage {
+    uint64_t sequence=0,captured=0;uint32_t mode=0;
+    std::string bgra;
+};
+HudImage latest_hud;
+std::mutex hud_mutex;
+class HudPageHandler final:public PageHandler {
+public:
+    HudPageHandler() { flags=PFLAG_READABLE|PFLAG_NOCODE; }
+    HostPt GetHostReadPt(Bitu page) override {
+        const auto index=page-hud.pages.front().page;
+        return index<hud.pages.size()?hud.pages[index].host:nullptr;
+    }
+    uint8_t readb(PhysPt address) override {
+        return GetHostReadPt(address/MemPageSize)[address%MemPageSize];
+    }
+    void writeb(PhysPt address,uint8_t value) override {
+        auto host=GetHostReadPt(address/MemPageSize);
+        host[address%MemPageSize]=value;
+        if(address>=hud.framebuffer&&static_cast<uint64_t>(address)-hud.framebuffer<HudPixels)
+            hud.alpha[address-hud.framebuffer]=255;
+    }
+} hud_handler;
+void stop_hud_coverage() {
+    if(!hud.active)return;
+    for(const auto& page:hud.pages)MEM_SetPageHandler(page.page,1,page.original);
+    PAGING_ClearTLB();hud.active=false;
+}
+bool start_hud_coverage() {
+    stop_hud_coverage();hud.pending=false;hud.pages.clear();
+    // Paging and sub-1MiB aliases require separate translation handling. These
+    // are not used by the verified S1 protected-mode software framebuffer.
+    const auto fb=mem_readd(data(0x121528));
+    if(PAGING_Enabled()||fb<0x100000||!in_ram(fb,HudPixels))return false;
+    const uint32_t first=fb/MemPageSize,last=(fb+HudPixels-1)/MemPageSize;
+    for(uint32_t page=first;page<=last;page++) {
+        auto previous=MEM_GetPageHandler(page);
+        const auto host=previous->GetHostReadPt(page);
+        if(!host||host!=previous->GetHostWritePt(page)||
+           (previous->flags&(PFLAG_READABLE|PFLAG_WRITEABLE|PFLAG_HASROM|PFLAG_HASCODE))!=
+                (PFLAG_READABLE|PFLAG_WRITEABLE)) {hud.pages.clear();return false;}
+        hud.pages.push_back({page,previous,host});
+    }
+    hud.framebuffer=fb;hud.mode=mem_readd(data(0x1100c0));hud.alpha.fill(0);
+    for(const auto& page:hud.pages)MEM_SetPageHandler(page.page,1,&hud_handler);
+    PAGING_ClearTLB();hud.active=true;return true;
+}
+Bitu hud_end_callback() {
+    if(hud.active) {
+        stop_hud_coverage();
+        MEM_BlockRead(hud.framebuffer,hud.indices.data(),HudPixels);
+        hud.captured=now_ns();hud.sequence++;hud.pending=true;state.hud_captures++;
+    }
+    reg_eip=code(FrameCall+5)-SegPhys(cs);return CBRET_NONE;
+}
+Bitu frame_begin_callback() {
+    stop_hud_coverage();
+    CPU_Push32(CALLBACK_PhysPointer(state.hud_end)-SegPhys(cs));
+    reg_eip=code(FrameTarget)-SegPhys(cs);return CBRET_NONE;
+}
+Bitu hud_begin_callback() {
+    state.hud_calls++;
+    // This call site belongs only to the main-race frame function. Capture
+    // while falling back as well, so Metal can wait for a real HUD before
+    // advertising renderer readiness. Coverage does not modify guest pixels.
+    if(!start_hud_coverage())state.hud_rejected++;
+    CPU_Push32(code(HudCall+5)-SegPhys(cs));
+    reg_eip=code(HudTarget)-SegPhys(cs);return CBRET_NONE;
+}
+Bitu backend_callback() {
+    state.callbacks++;
+    const uint32_t cs_base=SegPhys(cs);
+    const uint32_t resume=code(BackendCall+5)-cs_base;
+    // A near CALL normally preserves every register and flag except ESP/EIP.
+    // DOSBox's native FE38 callback materializes lazy flags in both CPU cores.
+    // Main 81ab0 saves pushad (32 bytes) + four 32-bit segment pushes (16).
+    // Only this exact main-race caller may bypass the polygon backend.
+    bool main_race=false;
+    const uint64_t stack=static_cast<uint64_t>(SegPhys(ss))+(reg_esp&cpu.stack.mask);
+    if(cpu.pmode && cpu.code.big && cpu.stack.big && in_ram(stack,52)) {
+        const uint32_t caller=mem_readd(static_cast<uint32_t>(stack)+48);
+        state.last_outer_return=caller+cs_base;
+        main_race=(caller==code(MainRaceReturn)-cs_base);
+        if(main_race)state.main_race_calls++;
+    } else state.stack_rejected++;
+    const bool digital=(in_ram(data(0x1100c0),4)&&mem_readd(data(0x1100c0))==2);
+    state.last_hud_mode=mem_readd(data(0x1100c0));
+    if(main_race && digital && live_ready()) {
+        state.skipped++;
+        // Original843CD always clears direction before returning.
+        reg_flags&=~FLAG_DF;cpu.direction=1;
+        reg_eip=resume;
+        return CBRET_NONE;
+    }
+    state.fallback++;
+    // Reproduce precisely the intercepted near CALL, including its five-byte
+    // return address (FE38 itself is four bytes followed by one padding NOP).
+    CPU_Push32(resume);
+    reg_eip=code(BackendTarget)-cs_base;
+    return CBRET_NONE;
+}
+void install(uint32_t code_base,uint32_t data_base) {
+    if(state.installed) {
+        if(code_base!=state.code_base||data_base!=state.data_base)
+            throw std::invalid_argument("S1 mapping changed; restart private runtime");
+        const std::array<uint8_t,5> hud_hook={0xfe,0x38,state.hud_begin,0x00,0x90};
+        const std::array<uint8_t,5> frame_hook={0xfe,0x38,state.frame_begin,0x00,0x90};
+        if(!matches(code(BackendCall),hook_bytes())||!matches(code(HudCall),hud_hook)||!matches(code(FrameCall),frame_hook))
+            throw std::invalid_argument("S1 backend hook no longer matches");
+        return;
+    }
+    if(code_base%16||data_base%16||!in_ram(code_base,899731)||!in_ram(data_base,291520))
+        throw std::invalid_argument("Invalid S1 LE object ranges");
+    if(!(static_cast<uint64_t>(code_base)+899731<=data_base || static_cast<uint64_t>(data_base)+291520<=code_base))
+        throw std::invalid_argument("Overlapping S1 LE object ranges");
+    state.code_base=code_base;state.data_base=data_base;
+    // Independent immutable call/prologue guards plus the relocated original
+    // two-tick wait helper. The Python owner validates the full EXE SHA before
+    // supplying its independently resolved LE mappings.
+    const std::array<uint8_t,5> wait_tail={0x83,0xfa,0x02,0x72,0xf5};
+    if(!matches(code(BackendCall),OriginalCall)||!matches(code(0x1fff7),MainRaceCall)||
+       !matches(code(0x2001a),MainHudCall)||!matches(code(FrameCall),OriginalFrameCall)||!matches(code(0x81ab5),WorldSave)||
+       !matches(code(0x1fc46),wait_tail)||mem_readw(code(0x1fc40))!=0x158b||
+       mem_readd(code(0x1fc42))!=code(0x107f9))
+        throw std::invalid_argument("Original S1 graphics/wait guards differ");
+    state.callback=CALLBACK_Allocate();
+    if(!CALLBACK_Setup(state.callback,backend_callback,CB_RETN,"S1 original polygon backend bridge"))
+        throw std::runtime_error("Cannot allocate S1 callback");
+    state.hud_begin=CALLBACK_Allocate();state.hud_end=CALLBACK_Allocate();state.frame_begin=CALLBACK_Allocate();
+    if(!CALLBACK_Setup(state.hud_begin,hud_begin_callback,CB_RETN,"S1 original HUD coverage begin")||
+       !CALLBACK_Setup(state.hud_end,hud_end_callback,CB_RETN,"S1 original HUD coverage end")||
+       !CALLBACK_Setup(state.frame_begin,frame_begin_callback,CB_RETN,"S1 original frame wrapper"))
+        throw std::runtime_error("Cannot allocate S1 HUD callbacks");
+    const auto hook=hook_bytes();MEM_BlockWrite(code(BackendCall),hook.data(),hook.size());
+    const std::array<uint8_t,5> hud_hook={0xfe,0x38,state.hud_begin,0x00,0x90};
+    MEM_BlockWrite(code(HudCall),hud_hook.data(),hud_hook.size());
+    const std::array<uint8_t,5> frame_hook={0xfe,0x38,state.frame_begin,0x00,0x90};
+    MEM_BlockWrite(code(FrameCall),frame_hook.data(),frame_hook.size());
+    if(!matches(code(BackendCall),hook)||!matches(code(HudCall),hud_hook)||!matches(code(FrameCall),frame_hook))throw std::runtime_error("S1 hook verification failed");
+    state.installed=true;
+}
+json status() {
+    const bool ready=live_ready();const auto now=now_ns();
+    return {{"profile_sha256",ProfileHash},{"installed",state.installed},{"renderer_ready",ready},
+        {"lease_ms",600},{"lease_remaining_ms",ready&&state.lease>now?(state.lease-now)/1000000:0},
+        {"code_base",state.code_base},{"data_base",state.data_base},
+        {"callbacks",state.callbacks},{"backend_skipped",state.skipped},{"backend_original",state.fallback},
+        {"expired_leases",state.expired},{"stack_rejected",state.stack_rejected},
+        {"main_race_calls",state.main_race_calls},{"last_outer_return_physical",state.last_outer_return},
+        {"last_hud_mode",state.last_hud_mode},{"hud_calls",state.hud_calls},{"hud_captures",state.hud_captures},
+        {"hud_rejected",state.hud_rejected},{"hud_framebuffer",hud.framebuffer},{"hud_sequence",hud.sequence},
+        {"supported_hud_mode",2},{"physics_wait_ticks",2},{"error",state.error}};
+}
+class ControlCommand final:public Command {
+public:
+    bool ready=false,has_mapping=false;
+    uint32_t code_base=0,data_base=0;
+    json result;
+    void Execute() override {
+        try {
+            if(has_mapping)install(code_base,data_base);
+            if(ready&&!state.installed)throw std::invalid_argument("Install guarded S1 mapping first");
+            state.ready=ready;state.lease=ready?now_ns()+LeaseNs:0;state.error.clear();result=status();
+        } catch(const std::exception& e) { state.ready=false;state.lease=0;state.error=e.what();error=e.what(); }
+    }
+};
+class StatusCommand final:public Command {
+public:json result;void Execute() override {result=status();}
+};
+} // namespace
+void S1NativePublishFrame(const Render& source) {
+    if(!RallyEnabled()||!state.installed||!hud.pending)return;
+    // Same VGA palette epoch as the original display publish. 8beb8 uses
+    // q=floor(400*65536/480), adding q BEFORE each output scanline.
+    if(source.src.pixel_format!=PixelFormat::Indexed8||source.src.width!=640||source.src.height!=480)return;
+    HudImage image;image.sequence=hud.sequence;image.captured=hud.captured;image.mode=hud.mode;
+    image.bgra.resize(640*480*4);auto out=reinterpret_cast<uint8_t*>(image.bgra.data());
+    constexpr uint32_t step=(400u<<16)/480u;
+    for(uint32_t y=0;y<480;y++) {
+        const auto sy=std::min(399u,((y+1)*step)>>16);
+        for(uint32_t x=0;x<640;x++,out+=4) {
+            const size_t at=sy*640+x;const auto c=source.palette.rgb[hud.indices[at]];
+            const uint8_t alpha=hud.alpha[at];
+            out[0]=alpha?c.blue:0;out[1]=alpha?c.green:0;out[2]=alpha?c.red:0;out[3]=alpha;
+        }
+    }
+    hud.pending=false;
+    std::lock_guard<std::mutex> lock(hud_mutex);latest_hud=std::move(image);
+}
+void S1NativeHud(const httplib::Request&,httplib::Response& response) {
+    if(!RallyEnabled()){response.status=404;return;}
+    HudImage image;{std::lock_guard<std::mutex> lock(hud_mutex);image=latest_hud;}
+    if(image.bgra.empty()){response.status=503;response.set_content("Original S1 HUD not ready","text/plain");return;}
+    response.set_header("X-S1-Hud-Width","640");response.set_header("X-S1-Hud-Height","480");
+    response.set_header("X-S1-Hud-Sequence",std::to_string(image.sequence));
+    response.set_header("X-S1-Hud-Capture-Ns",std::to_string(image.captured));
+    response.set_header("X-S1-Hud-Mode",std::to_string(image.mode));
+    response.set_header("X-S1-Hud-Coverage","original-ram-byte-writes");
+    response.set_header("Cache-Control","no-store");
+    response.set_content(std::move(image.bgra),"application/octet-stream");
+}
+void S1NativeWatchdog() { if(RallyEnabled())live_ready(); }
+void S1NativeControl(const httplib::Request& request,httplib::Response& response) {
+    if(!RallyEnabled()){response.status=404;return;}
+    if(request.body.size()>4096)throw std::invalid_argument("Oversized S1 renderer control");
+    const auto input=json::parse(request.body);
+    if(input.value("profile_sha256",std::string{})!=ProfileHash)
+        throw std::invalid_argument("Unsupported original S1 profile");
+    ControlCommand cmd;cmd.ready=input.at("renderer_ready").get<bool>();
+    if(input.contains("code_base")||input.contains("data_base")) {
+        const auto cb=input.at("code_base").get<uint64_t>(),db=input.at("data_base").get<uint64_t>();
+        if(cb>UINT32_MAX||db>UINT32_MAX)throw std::invalid_argument("Invalid S1 object base");
+        cmd.code_base=static_cast<uint32_t>(cb);cmd.data_base=static_cast<uint32_t>(db);cmd.has_mapping=true;
+    }
+    cmd.WaitForCompletion();if(!cmd.error.empty())throw std::invalid_argument(cmd.error);send_json(response,cmd.result);
+}
+void S1NativeStatus(const httplib::Request&,httplib::Response& response) {
+    if(!RallyEnabled()){response.status=404;return;}StatusCommand cmd;cmd.WaitForCompletion();send_json(response,cmd.result);
+}
