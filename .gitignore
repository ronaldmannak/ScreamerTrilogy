.DS_Store
Archives/
**/Runtime/
**/dist/
**/rebuild/
**/backups/
**/recovery/
**/__pycache__/
*.pyc
*.app/
wrappers/**/artwork/**/*.png
# Extracted game data and native-renderer captures remain local.
NativeRenderer/Captures/
NativeRenderer/Assets/Extracted/
NativeRenderer/build/

# Renderer capture/replay payloads belong under ignored Captures, not source.
NativeRenderer/bridge/replay*.json
!NativeRenderer/bridge/*-verification.json
NativeRenderer/**/*.trace/
NativeRenderer/Validation/*.png

# Separate playable native builds and pinned external build trees.
NativeRenderer/build-*/
NativeRenderer/EngineBuild/

# These Runtime directories contain reviewed source, not bundled binaries.
!NativeRenderer/Games/*/Runtime/
!NativeRenderer/Games/*/Runtime/**
NativeRenderer/Games/**/__pycache__/
NativeRenderer/Games/**/*.pyc

# Owned game imports, installers, discs and extracted media are never source.
Content/
GameData/
Imports/
